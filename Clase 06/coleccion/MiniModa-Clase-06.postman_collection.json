        "body": {
          "mode": "raw",
          "raw": "{\n  \"carritoId\": \"{{carritoId}}\",\n  \"email\": \"ana@ejemplo.com\",\n  \"tarjeta\": \"4111111111111111\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
