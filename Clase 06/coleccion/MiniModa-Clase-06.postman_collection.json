        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"pedidoId\");",
              "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"clase6-{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// paths./pedidos.post.responses.201 · components.schemas.Pedido",
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Pedido confirmado para el carrito\", function () { const body = pm.response.json(); pm.expect(body.id).to.be.a(\"string\").and.not.empty; pm.expect(body.carritoId).to.equal(pm.collectionVariables.get(\"carritoId\")); pm.expect(body.estado).to.equal(\"confirmado\"); if (pm.response.code === 201) pm.collectionVariables.set(\"pedidoId\", body.id); });"
            ]
          }
        }
