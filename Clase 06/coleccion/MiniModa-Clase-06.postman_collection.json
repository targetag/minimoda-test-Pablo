      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// paths./productos/{id}.get.responses.404 · components.schemas.Error",
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"Error cumple el esquema OpenAPI\", function () { const body = pm.response.json(); pm.expect(body.codigo).to.be.a(\"string\"); pm.expect(body.mensaje).to.be.a(\"string\"); pm.expect(body.detalles).to.be.an(\"array\"); body.detalles.forEach(value => pm.expect(value).to.be.a(\"string\")); });"
