              "pm.test(\"La lectura devuelve el carrito y su ítem con precio numérico\", function () { const body = pm.response.json(); pm.expect(body.id).to.equal(pm.collectionVariables.get(\"carritoId\")); pm.expect(body.estado).to.be.oneOf([\"abierto\", \"cerrado\"]); pm.expect(body.subtotal).to.be.a(\"number\"); pm.expect(body.items).to.be.an(\"array\"); const item = body.items.find(value => value.productoId === 3); pm.expect(item).to.have.property(\"cantidad\", 1); pm.expect(item.nombre).to.be.a(\"string\"); pm.expect(item.precioUnitario).to.be.a(\"number\"); pm.expect(item.subtotal).to.be.a(\"number\"); });"
